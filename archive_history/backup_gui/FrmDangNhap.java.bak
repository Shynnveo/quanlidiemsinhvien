    private void btnDangNhapActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_btnDangNhapActionPerformed
        xuLyDangNhap();
    }//GEN-LAST:event_btnDangNhapActionPerformed

    private void btnThoatActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_btnThoatActionPerformed
        int confirm = JOptionPane.showConfirmDialog(this,
                "Bạn có chắc chắn muốn thoát phần mềm?",
                "Xác nhận thoát", JOptionPane.YES_NO_OPTION);
        if (confirm == JOptionPane.YES_OPTION) {
            System.exit(0);
        }
    }//GEN-LAST:event_btnThoatActionPerformed

    private void txtTenDangNhapActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_txtTenDangNhapActionPerformed
        txtMatKhau.requestFocus();
    }//GEN-LAST:event_txtTenDangNhapActionPerformed

    private void txtMatKhauActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_txtMatKhauActionPerformed
        xuLyDangNhap();
    }//GEN-LAST:event_txtMatKhauActionPerformed

    private void btnDangKyActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_btnDangKyActionPerformed
        new FrmDangKyTaiKhoan().setVisible(true);
        this.dispose();
    }//GEN-LAST:event_btnDangKyActionPerformed

    /**
     * Phương thức xử lý đăng nhập người dùng
     */
    private void xuLyDangNhap() {
        String tenDangNhap = txtTenDangNhap.getText();
        String matKhau = new String(txtMatKhau.getPassword());

        // Hiển thị trạng thái bận và tạm vô hiệu hóa các nút để chống nhấn lặp
        btnDangNhap.setEnabled(false);
        btnDangKy.setEnabled(false);
        setCursor(java.awt.Cursor.getPredefinedCursor(java.awt.Cursor.WAIT_CURSOR));

        try {
            TaiKhoan tk = dangNhapService.dangNhap(tenDangNhap, matKhau);

            JOptionPane.showMessageDialog(this,
                    "Đăng nhập thành công!\n"
                    + "Xin chào: " + tk.getHoTen() + "\n"
                    + "Vai trò: " + tk.getVaiTro(),
                    "Thành công", JOptionPane.INFORMATION_MESSAGE);

            // Chuyển hướng sang Form Trang Chủ theo đúng phân quyền
            FrmTrangChu trangChu = new FrmTrangChu();
            trangChu.setVisible(true);
            this.dispose();

        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this,
                    ex.getMessage(),
                    "Lỗi đăng nhập",
                    JOptionPane.ERROR_MESSAGE);
            txtMatKhau.setText("");
            txtMatKhau.requestFocus();
        } finally {
            // Luôn khôi phục trạng thái nút và con trỏ chuột kể cả khi đăng nhập thất bại
            btnDangNhap.setEnabled(true);
            btnDangKy.setEnabled(true);
            setCursor(java.awt.Cursor.getDefaultCursor());
        }
    }

    /**
     * Hiển thị hộp thoại hướng dẫn khi người dùng nhấn "Quên mật khẩu?"
     */
    private void hienThiHuongDanQuenMatKhau() {
        String thongBao = "QUY TRÌNH HỖ TRỢ ĐẶT LẠI MẬT KHẨU\n\n"
                + "1. Để đảm bảo an toàn thông tin tài khoản và kết quả học tập,\n"
                + "   hệ thống không cung cấp chức năng lấy lại mật khẩu tự động.\n\n"
                + "2. Người dùng quên mật khẩu vui lòng liên hệ trực tiếp Quản trị viên (Admin)\n"
                + "   hoặc Bộ phận Đào tạo của Nhà trường để được xác minh danh tính.\n\n"
                + "3. Sau khi xác minh thành công, Quản trị viên sẽ hỗ trợ đặt lại mật khẩu\n"
                + "   và cung cấp thông tin đăng nhập tạm thời một cách bảo mật.\n";
        JOptionPane.showMessageDialog(this, thongBao, "Quên mật khẩu", JOptionPane.INFORMATION_MESSAGE);
    }

    /**
     * Hiển thị hộp thoại hướng dẫn khi người dùng nhấn "Hỗ trợ"
     */
    private void hienThiHuongDanHoTro() {
        String thongBao = "HƯỚNG DẪN XỬ LÝ SỰ CỐ THƯỜNG GẶP\n\n"
                + "1. Đăng nhập thất bại:\n"
                + "   - Kiểm tra phím Caps Lock và bộ gõ tiếng Việt (Telex/VNI).\n"
                + "   - Nhập chính xác Tên đăng nhập và Mật khẩu được cấp.\n"
                + "   - Nếu hệ thống báo tài khoản bị khóa, vui lòng liên hệ Quản trị viên.\n\n"
                + "2. Quên mật khẩu:\n"
                + "   - Sử dụng chức năng 'Quên mật khẩu?' để xem quy trình yêu cầu cấp lại.\n\n"
                + "3. Chưa có tài khoản:\n"
                + "   - Sinh viên mới có thể bấm 'Đăng ký tài khoản sinh viên' để tạo tài khoản liên kết.\n\n"
                + "4. Không xem được kết quả học tập:\n"
                + "   - Kết quả chỉ hiển thị khi giảng viên phụ trách đã hoàn tất nhập điểm lên hệ thống.\n"
                + "   - Nếu phát hiện sai sót điểm, sinh viên có thể sử dụng chức năng Phúc khảo sau khi đăng nhập.\n\n"
                + "5. Lỗi kết nối hoặc sử dụng phần mềm:\n"
                + "   - Kiểm tra kết nối mạng và đảm bảo dịch vụ cơ sở dữ liệu đang chạy bình thường.\n"
                + "   - Khởi động lại ứng dụng nếu gặp hiện tượng phản hồi chậm.\n";
        JOptionPane.showMessageDialog(this, thongBao, "Trung tâm Hỗ trợ", JOptionPane.INFORMATION_MESSAGE);
    }

